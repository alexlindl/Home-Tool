# Web App Environment Variables
# Copy this file to .env and fill in your actual values

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3001

# App Configuration
VITE_APP_NAME=Household Management
VITE_APP_VERSION=0.4.0-alpha

# Feature Flags
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_HOME_ASSISTANT=false

# Debug Settings
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info

# Admin API guard (optional)
# Must match the backend ADMIN_API_SECRET. When set, the Settings admin actions
# (backup/restore/reset/config) send it as the X-Admin-Secret header. Leave
# blank to disable. Note: values baked into the web build are visible to anyone
# with the app, so this guards against other-device/direct-port access, not the
# authenticated user.
VITE_ADMIN_API_SECRET=
